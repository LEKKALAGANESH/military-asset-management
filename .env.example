# Copy to .env for local development. On Vercel these are set in
# Project Settings -> Environment Variables (never commit the real .env).

# ---- Database (REQUIRED) --------------------------------------------------
# MUST be the POOLED connection string. A direct endpoint will exhaust Postgres
# connections once more than a handful of serverless instances are warm.
#   Neon      -> the host containing "-pooler"
#   Supabase  -> the transaction pooler on port 6543 (not 5432)
#   Vercel Postgres -> POSTGRES_URL (already pooled)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/mams?sslmode=require

# TLS is on by default. Set to false only for a local Postgres.
DATABASE_SSL=true
# Preferred in production: paste the provider's CA certificate (PEM).
DATABASE_CA_CERT=
# Last resort for providers shipping a self-signed cert. Never enable in production.
DATABASE_SSL_NO_VERIFY=false

# One connection per function instance. Raise only if you know why.
DB_POOL_MAX=1

# ---- Auth (REQUIRED) ------------------------------------------------------
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string_min_16_chars
JWT_EXPIRES_IN=8h

# ---- Optional -------------------------------------------------------------
# Leave EMPTY when the SPA and API share one Vercel domain (the default setup) —
# same-origin requests send no Origin header, so CORS never engages.
# Only set this if a separately-hosted frontend calls this API.
CORS_ORIGIN=

# Per-instance in-memory limits. See README: Vercel Firewall is the real control.
RATE_LIMIT=300
AUTH_RATE_LIMIT=10

# Local development only.
PORT=4000
