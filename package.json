{
  "name": "mams-serverless",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Military Asset Management System — Vercel serverless (React SPA + Express API on one origin)",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch dev-server.js",
    "build": "vite build",
    "preview": "vite preview",
    "db:local": "node scripts/local-db.js",
    "db:schema": "node server/db/apply-schema.js",
    "db:seed": "node server/db/seed.js",
    "db:reset": "npm run db:schema && npm run db:seed",
    "test": "node --test"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.469.0",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@electric-sql/pglite-socket": "^0.2.8",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  }
}
